local function CreateToggle(name, y)
    local row = Instance.new("Frame")
    row.Position = UDim2.fromOffset(12, y)
    row.Size = UDim2.fromOffset(145, 35)
    row.BackgroundColor3 = Color3.fromRGB(22, 29, 49)
    row.Parent = Main
    Corner(row, 6)

    local text = Label(row, name,
        UDim2.fromOffset(8, 0),
        UDim2.new(1, -48, 1, 0),
        Color3.fromRGB(230, 235, 255))
    text.Font = Enum.Font.Gotham
    text.TextSize = 10
    text.TextXAlignment = Enum.TextXAlignment.Left

    local toggle = Button(row, "OFF",
        UDim2.new(1, -43, 0.5, -10),
        UDim2.fromOffset(37, 20))

    local enabled = false

    toggle.MouseButton1Click:Connect(function()
        enabled = not enabled
        toggle.Text = enabled and "ON" or "OFF"
        toggle.BackgroundColor3 = enabled
            and Color3.fromRGB(35, 160, 100)
            or Color3.fromRGB(65, 75, 95)
    end)
end

