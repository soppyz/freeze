local function Label(parent, text, pos, size, color)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.Position = pos
    l.Size = size
    l.TextColor3 = color
    l.Font = Enum.Font.GothamBold
    l.TextSize = 12
    l.Parent = parent
    return l
end

Label(Main, "TRADE CONTROLLER",
